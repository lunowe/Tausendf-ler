# Kopieren nach .env.local (wird nicht committed). Beide Werte landen im Browser-Bundle –
# das Frontend ist deshalb nur fuer den lokalen Betrieb gedacht.

# Basis-URL der Koordinator-REST-API. Muss zu tausendfuessler.cors-origins passen.
NEXT_PUBLIC_COORDINATOR_URL=http://localhost:8080

# API-Key des Koordinators (dort: API_KEY). Leer lassen, wenn der Koordinator ohne Key laeuft.
NEXT_PUBLIC_API_KEY=
