# Kopieren nach .env (wird nicht committed) und Werte eintragen.

# Telegram (Token von @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_USERNAME=tausfler_bot

# Koordinator
COORDINATOR_BASE_URL=http://localhost:8080
COORDINATOR_WORKER_PORT=9090

# Shared Secrets (leer lassen = keine Authentifizierung, nur lokal sinnvoll).
# API_KEY: Header X-Api-Key fuer die REST-API (Bot, Frontend, Lasttest); WORKER_TOKEN: Feld token in REGISTER (Worker).
# Erzeugen z. B. mit: openssl rand -hex 24
API_KEY=
WORKER_TOKEN=

# Datenbank (lokal via docker compose, oder die geteilte Cloud-Instanz)
DB_URL=jdbc:postgresql://localhost:5433/tausendfuessler
DB_USER=tausendfuessler
DB_PASSWORD=tausendfuessler
